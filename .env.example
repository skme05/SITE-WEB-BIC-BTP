# Copier ce fichier en .env puis adapter les valeurs :  cp .env.example .env

# ---------- Django ----------
DJANGO_SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,bicbtp.ci,www.bicbtp.ci
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://bicbtp.ci,https://www.bicbtp.ci
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://bicbtp.ci,https://www.bicbtp.ci

# ---------- PostgreSQL ----------
POSTGRES_DB=bicbtp
POSTGRES_USER=bicbtp
POSTGRES_PASSWORD=changez-moi

# ---------- Email ----------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=contact@bicbtp.ci
CONTACT_TEAM_EMAILS=
CONTACT_WHATSAPP_URL=https://wa.me/22500000000

# ---------- Frontend / Nginx ----------
# Laisser vide : le frontend appelle /api sur la même origine (proxy Nginx)
VITE_API_BASE_URL=
HTTP_PORT=8080
